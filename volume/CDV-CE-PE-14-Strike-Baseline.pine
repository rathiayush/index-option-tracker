//@version=5
indicator("delta auto with Delta-Weighted CDV", overlay=false, dynamic_requests=true)

// ===== Auto-detect Index from Chart Symbol =====
chartSym  = syminfo.ticker
indexName = str.contains(chartSym, "BANKNIFTY") ? "BANKNIFTY" : str.contains(chartSym, "FINNIFTY") ? "FINNIFTY" : str.contains(chartSym, "MIDCPNIFTY") ? "MIDCPNIFTY" : str.contains(chartSym, "SENSEX") ? "SENSEX" : str.contains(chartSym, "BANKEX") ? "BANKEX" : str.contains(chartSym, "NIFTY") ? "NIFTY" : input.string("NIFTY", "Index Name (fallback)", options=["NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY", "SENSEX", "BANKEX"])

// ===== Inputs =====
atmStrike      = input.int(24000, "ATM Strike")
smoothLen      = input.int(9, "CDV EMA Length", minval=1)
displayMode    = input.string("Raw", "Display Mode", options=["Raw", "Percent"])
rawChartUnit   = input.string("K", "Raw Chart Unit", options=["K", "M"])
showTable      = input.bool(true, "Show % Change Table")
showDayChangeTable = input.bool(true, "Show Day vs Current Table")
showResetDebug = input.bool(false, "Show Daily Reset Marker")

// ===== NEW: Delta-Weighting Toggle =====
useDeltaWeighting = input.bool(true, "Use Delta Weighting (Volume × Delta)")

// ===== Auto Strike Step per Index =====
strikeStep = indexName == "BANKNIFTY" ? 100 : indexName == "FINNIFTY" ? 50 : indexName == "MIDCPNIFTY" ? 25 : indexName == "SENSEX" ? 100 : indexName == "BANKEX" ? 100 : 50

// ===== Auto-fetch Underlying Price (display only) =====
f_underlying_sym(_name) =>
    switch _name
        "NIFTY"      => "NSE:NIFTY"
        "BANKNIFTY"  => "NSE:BANKNIFTY"
        "FINNIFTY"   => "NSE:FINNIFTY"
        "MIDCPNIFTY" => "NSE:MIDCPNIFTY"
        "SENSEX"     => "BSE:SENSEX"
        "BANKEX"     => "BSE:BANKEX"
        => "NSE:NIFTY"

underlyingSym   = f_underlying_sym(indexName)
underlyingPrice = request.security(underlyingSym, timeframe.period, close)

// ===== Date Helpers =====
f_2d(n) =>
    int(n) < 10 ? "0" + str.tostring(int(n)) : str.tostring(int(n))

f_expiry_code(yy, mm, dd) =>
    str.tostring(int(yy)) + f_2d(int(mm)) + f_2d(int(dd))

curYear  = year(timenow)
curMonth = month(timenow)
curDay   = dayofmonth(timenow)
curYY    = int(curYear % 100)

// ===== BANKNIFTY: Monthly Expiry =====
f_bnf_expiry_day(mm) =>
    switch mm
        1  => 27
        2  => 24
        3  => 30
        4  => 28
        5  => 26
        6  => 30
        7  => 28
        8  => 25
        9  => 29
        10 => 19
        11 => 23
        12 => 29
        => 28

f_bnf_next_expiry() =>
    mm   = curMonth
    yy   = curYY
    eDay = f_bnf_expiry_day(mm)
    if curDay > eDay
        mm   := mm == 12 ? 1 : mm + 1
        yy   := mm == 1 ? yy + 1 : yy
        eDay := f_bnf_expiry_day(mm)
    f_expiry_code(yy, mm, eDay)

// ===== NIFTY: Weekly Tuesday Expiry (2026 hardcoded) =====
f_nifty_next_expiry() =>
    today_mmdd = curMonth * 100 + curDay
    expiries = array.from(505, 512, 519, 526, 602, 609, 616, 623, 630, 707, 714, 721, 728, 804, 811, 818, 825, 901, 908, 915, 922, 929, 1006, 1013, 1019, 1027, 1103, 1110, 1117, 1124, 1201, 1208, 1215, 1222, 1229)
    picked_mmdd = 1229
    for i = 0 to array.size(expiries) - 1
        val = array.get(expiries, i)
        if today_mmdd <= val
            picked_mmdd := val
            break
    picked_mm = math.floor(picked_mmdd / 100)
    picked_dd = picked_mmdd - (math.floor(picked_mmdd / 100) * 100)
    f_expiry_code(curYY, picked_mm, picked_dd)

// ===== SENSEX / BANKEX: Weekly Thursday Expiry =====
f_next_thursday_expiry() =>
    dow = dayofweek(timenow, "Asia/Kolkata")
    daysAhead = dow <= 5 ? 5 - dow : 7 - dow + 5
    expiryTs  = timenow + daysAhead * 86400000
    eYY  = int(year(expiryTs, "Asia/Kolkata") % 100)
    eMon = month(expiryTs, "Asia/Kolkata")
    eDay = dayofmonth(expiryTs, "Asia/Kolkata")
    f_expiry_code(eYY, eMon, eDay)

// ===== FINNIFTY / MIDCPNIFTY: Weekly Tuesday Expiry (dynamic) =====
f_next_tuesday_expiry() =>
    dow = dayofweek(timenow, "Asia/Kolkata")
    daysAhead = dow <= 3 ? 3 - dow : 7 - dow + 3
    expiryTs  = timenow + daysAhead * 86400000
    eYY  = int(year(expiryTs, "Asia/Kolkata") % 100)
    eMon = month(expiryTs, "Asia/Kolkata")
    eDay = dayofmonth(expiryTs, "Asia/Kolkata")
    f_expiry_code(eYY, eMon, eDay)

// ===== Route Expiry by Index =====
expiryCode = indexName == "BANKNIFTY" ? f_bnf_next_expiry() : indexName == "NIFTY" ? f_nifty_next_expiry() : indexName == "SENSEX" ? f_next_thursday_expiry() : indexName == "BANKEX" ? f_next_thursday_expiry() : f_next_tuesday_expiry()

// ===== Symbol Builder =====
f_sym(_strike, _isCall) =>
    str.upper(indexName) + expiryCode + (_isCall ? "C" : "P") + str.tostring(int(_strike))

// ===== MODIFIED: CDV Calculation with Delta Weighting =====
f_get_delta(_strike, _isCall, _spot) =>
    moneyness = (_strike - _spot) / _spot
    if _isCall
        1 / (1 + math.exp(-1.7 * -moneyness * 5))
    else
        -1 / (1 + math.exp(-1.7 * moneyness * 5))

f_bar_delta_with_delta(_delta) =>
    hl = high - low
    if hl > 0.0001
        buy_vol  = ((close - low) / hl) * volume
        sell_vol = ((high - close) / hl) * volume
        (buy_vol - sell_vol) * _delta
    else
        0.0

f_bar_delta_standard() =>
    hl = high - low
    if hl > 0.0001
        buy_vol  = ((close - low) / hl) * volume
        sell_vol = ((high - close) / hl) * volume
        buy_vol - sell_vol
    else
        0.0

// FIXED: All on one line to avoid syntax error
f_cdv(_sym, _strike, _isCall, _spot) =>
    // Bug 2 fix: use math.abs() so PE delta weight is positive (magnitude only)
    deltaWeight = useDeltaWeighting ? math.abs(f_get_delta(_strike, _isCall, _spot)) : 1.0
    // Bug 1 fix: wrap in ta.cum() to accumulate delta across bars
    request.security(_sym, timeframe.period, ta.cum(useDeltaWeighting ? f_bar_delta_with_delta(deltaWeight) : f_bar_delta_standard()), lookahead=barmerge.lookahead_off)
// Get current spot for delta calculation
currentSpot = underlyingPrice

// ===== Strike Levels =====
ce_s7 = atmStrike - 7 * strikeStep
ce_s6 = atmStrike - 6 * strikeStep
ce_s5 = atmStrike - 5 * strikeStep
ce_s4 = atmStrike - 4 * strikeStep
ce_s3 = atmStrike - 3 * strikeStep
ce_s2 = atmStrike - 2 * strikeStep
ce_s1 = atmStrike - 1 * strikeStep
ce_s0 = atmStrike
ce_p1 = atmStrike + 1 * strikeStep
ce_p2 = atmStrike + 2 * strikeStep
ce_p3 = atmStrike + 3 * strikeStep
ce_p4 = atmStrike + 4 * strikeStep
ce_p5 = atmStrike + 5 * strikeStep
ce_p6 = atmStrike + 6 * strikeStep

pe_s7 = atmStrike - 7 * strikeStep
pe_s6 = atmStrike - 6 * strikeStep
pe_s5 = atmStrike - 5 * strikeStep
pe_s4 = atmStrike - 4 * strikeStep
pe_s3 = atmStrike - 3 * strikeStep
pe_s2 = atmStrike - 2 * strikeStep
pe_s1 = atmStrike - 1 * strikeStep
pe_s0 = atmStrike
pe_p1 = atmStrike + 1 * strikeStep
pe_p2 = atmStrike + 2 * strikeStep
pe_p3 = atmStrike + 3 * strikeStep
pe_p4 = atmStrike + 4 * strikeStep
pe_p5 = atmStrike + 5 * strikeStep
pe_p6 = atmStrike + 6 * strikeStep

// ===== CDV Aggregation =====
ceRawCdv = nz(f_cdv(f_sym(ce_s7, true), ce_s7, true, currentSpot)) + nz(f_cdv(f_sym(ce_s6, true), ce_s6, true, currentSpot)) + nz(f_cdv(f_sym(ce_s5, true), ce_s5, true, currentSpot)) + nz(f_cdv(f_sym(ce_s4, true), ce_s4, true, currentSpot)) + nz(f_cdv(f_sym(ce_s3, true), ce_s3, true, currentSpot)) + nz(f_cdv(f_sym(ce_s2, true), ce_s2, true, currentSpot)) + nz(f_cdv(f_sym(ce_s1, true), ce_s1, true, currentSpot)) + nz(f_cdv(f_sym(ce_s0, true), ce_s0, true, currentSpot)) + nz(f_cdv(f_sym(ce_p1, true), ce_p1, true, currentSpot)) + nz(f_cdv(f_sym(ce_p2, true), ce_p2, true, currentSpot)) + nz(f_cdv(f_sym(ce_p3, true), ce_p3, true, currentSpot)) + nz(f_cdv(f_sym(ce_p4, true), ce_p4, true, currentSpot)) + nz(f_cdv(f_sym(ce_p5, true), ce_p5, true, currentSpot)) + nz(f_cdv(f_sym(ce_p6, true), ce_p6, true, currentSpot))

peRawCdv = nz(f_cdv(f_sym(pe_s7, false), pe_s7, false, currentSpot)) + nz(f_cdv(f_sym(pe_s6, false), pe_s6, false, currentSpot)) + nz(f_cdv(f_sym(pe_s5, false), pe_s5, false, currentSpot)) + nz(f_cdv(f_sym(pe_s4, false), pe_s4, false, currentSpot)) + nz(f_cdv(f_sym(pe_s3, false), pe_s3, false, currentSpot)) + nz(f_cdv(f_sym(pe_s2, false), pe_s2, false, currentSpot)) + nz(f_cdv(f_sym(pe_s1, false), pe_s1, false, currentSpot)) + nz(f_cdv(f_sym(pe_s0, false), pe_s0, false, currentSpot)) + nz(f_cdv(f_sym(pe_p1, false), pe_p1, false, currentSpot)) + nz(f_cdv(f_sym(pe_p2, false), pe_p2, false, currentSpot)) + nz(f_cdv(f_sym(pe_p3, false), pe_p3, false, currentSpot)) + nz(f_cdv(f_sym(pe_p4, false), pe_p4, false, currentSpot)) + nz(f_cdv(f_sym(pe_p5, false), pe_p5, false, currentSpot)) + nz(f_cdv(f_sym(pe_p6, false), pe_p6, false, currentSpot))

// ===== Day Opening Candle Baseline =====
isNewDay = ta.change(time("D")) != 0

var float ceBase          = na
var float peBase          = na
var float ceSecondBase    = na
var float peSecondBase    = na
var int   dayCandleNo     = 0
var float cePrevDayClose  = na
var float pePrevDayClose  = na
var bool  resetNow        = false

resetNow := false

if isNewDay
    ceBase       := na
    peBase       := na
    ceSecondBase := na
    peSecondBase := na
    dayCandleNo  := 0
    resetNow     := true

if barstate.isconfirmed
    dayCandleNo += 1
    if dayCandleNo == 1
        ceBase := ceRawCdv
        peBase := peRawCdv
    if dayCandleNo == 2
        ceSecondBase := ceRawCdv
        peSecondBase := peRawCdv

plotshape(showResetDebug and resetNow, title="Daily Baseline Reset", style=shape.labeldown, location=location.top, color=color.yellow, textcolor=color.black, text="RESET", size=size.tiny)

// ===== Delta from Baselines =====
ceDayRaw     = ceRawCdv - nz(ceBase, ceRawCdv)
peDayRaw     = peRawCdv - nz(peBase, peRawCdv)
ceFrom1stRaw = ceDayRaw
peFrom1stRaw = peDayRaw
ceFrom2ndRaw = not na(ceSecondBase) ? ceRawCdv - ceSecondBase : na
peFrom2ndRaw = not na(peSecondBase) ? peRawCdv - peSecondBase : na

ceFrom1stPct = math.abs(nz(ceBase)) > 0 ? (ceFrom1stRaw / math.abs(ceBase)) * 100 : 0.0
peFrom1stPct = math.abs(nz(peBase)) > 0 ? (peFrom1stRaw / math.abs(peBase)) * 100 : 0.0
ceFrom2ndPct = not na(ceSecondBase) and math.abs(ceSecondBase) > 0 ? (ceFrom2ndRaw / math.abs(ceSecondBase)) * 100 : na
peFrom2ndPct = not na(peSecondBase) and math.abs(peSecondBase) > 0 ? (peFrom2ndRaw / math.abs(peSecondBase)) * 100 : na

ceRawEma = ta.ema(ceFrom1stRaw, smoothLen)
peRawEma = ta.ema(peFrom1stRaw, smoothLen)
cePctEma = ta.ema(ceFrom1stPct, smoothLen)
pePctEma = ta.ema(peFrom1stPct, smoothLen)

useRaw     = displayMode == "Raw"
ceActive   = useRaw ? ceRawEma : cePctEma
peActive   = useRaw ? peRawEma : pePctEma

if isNewDay
    cePrevDayClose := ceActive[1]
    pePrevDayClose := peActive[1]

rawDiv     = rawChartUnit == "M" ? 1000000.0 : 1000.0
ceRawChart = ceRawEma / rawDiv
peRawChart = peRawEma / rawDiv

crossUp   = ta.crossover(ceActive, peActive)
crossDown = ta.crossunder(ceActive, peActive)

// ===== Alerts =====
f_json(txt) =>
    str.replace_all(str.replace_all(txt, "\n", "\\n"), '"', '\\"')

f_webhook_payload(_html_text) =>
    '{"chat_id":"-1003533948678","parse_mode":"HTML","text":"' + f_json(_html_text) + '"}'

if barstate.isconfirmed and crossUp
    modeTxt  = useRaw ? "Raw" : "Percent"
    deltaTxt = useDeltaWeighting ? " (Delta-Weighted)" : ""
    msg_html = "<b>CDV CE/PE CROSS ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Mode:</b> " + modeTxt + deltaTxt + "\n<b>Event:</b> Green crossed Red (BULL)\n<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and crossDown
    modeTxt  = useRaw ? "Raw" : "Percent"
    deltaTxt = useDeltaWeighting ? " (Delta-Weighted)" : ""
    msg_html = "<b>CDV CE/PE CROSS ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Mode:</b> " + modeTxt + deltaTxt + "\n<b>Event:</b> Red crossed Green (BEAR)\n<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

// ===== Plot =====
plot(0, "Opening Candle Baseline", color=color.new(color.gray, 20), linewidth=1, style=plot.style_line)
plot(useRaw ? ceRawChart : na, "CE CDV Raw", color=color.new(color.lime, 0), linewidth=2)
plot(useRaw ? peRawChart : na, "PE CDV Raw", color=color.new(color.red, 0), linewidth=2)
plot(not useRaw ? cePctEma : na, "CE CDV %", color=color.new(color.lime, 0), linewidth=2)
plot(not useRaw ? pePctEma : na, "PE CDV %", color=color.new(color.red, 0), linewidth=2)

// ===== Table =====
f_pct_color(v) =>
    na(v) ? color.new(color.gray, 0) : v > 0 ? color.new(color.lime, 0) : v < 0 ? color.new(color.red, 0) : color.new(color.gray, 0)

f_fmt_km(v) =>
    av = math.abs(v)
    av >= 1000000 ? str.tostring(v / 1000000, "#.00") + "M" : av >= 1000 ? str.tostring(v / 1000, "#.00") + "K" : str.tostring(v, "#.0")

var table t = table.new(position.top_right, 3, 10, border_width=1)

if barstate.islast and showTable
    table.cell(t, 0, 0, "Metric",             bgcolor=color.new(color.silver, 15), text_color=color.black)
    table.cell(t, 1, 0, "CE",                 bgcolor=color.new(color.silver, 15), text_color=color.black)
    table.cell(t, 2, 0, "PE",                 bgcolor=color.new(color.silver, 15), text_color=color.black)

    table.cell(t, 0, 1, indexName + " Price", bgcolor=color.new(color.navy, 60), text_color=color.white)
    table.cell(t, 1, 1, str.tostring(underlyingPrice, "#.00"), bgcolor=color.new(color.navy, 70), text_color=color.yellow)
    table.cell(t, 2, 1, "Chart: " + chartSym,  bgcolor=color.new(color.navy, 70), text_color=color.silver)

    table.cell(t, 0, 2, "ATM | Expiry",       bgcolor=color.new(color.navy, 60), text_color=color.white)
    table.cell(t, 1, 2, str.tostring(int(atmStrike)), bgcolor=color.new(color.navy, 70), text_color=color.yellow)
    table.cell(t, 2, 2, expiryCode,           bgcolor=color.new(color.navy, 70), text_color=color.yellow)

    table.cell(t, 0, 3, "Delta Weighting",    bgcolor=color.new(color.navy, 60), text_color=color.white)
    table.cell(t, 1, 3, useDeltaWeighting ? "ON" : "OFF", bgcolor=color.new(color.navy, 70), text_color=useDeltaWeighting ? color.lime : color.red)
    table.cell(t, 2, 3, "", bgcolor=color.new(color.navy, 70), text_color=color.white)

    table.cell(t, 0, 4, "1st Candle Raw",     bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 4, f_fmt_km(ceBase),     bgcolor=color.new(color.gray, 90), text_color=color.white)
    table.cell(t, 2, 4, f_fmt_km(peBase),     bgcolor=color.new(color.gray, 90), text_color=color.white)

    table.cell(t, 0, 5, "2nd Candle Raw",     bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 5, na(ceSecondBase) ? "Waiting" : f_fmt_km(ceSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(ceSecondBase) ? color.orange : color.white)
    table.cell(t, 2, 5, na(peSecondBase) ? "Waiting" : f_fmt_km(peSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(peSecondBase) ? color.orange : color.white)

    table.cell(t, 0, 6, "Current Raw",        bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 6, f_fmt_km(ceRawCdv),   bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceDayRaw))
    table.cell(t, 2, 6, f_fmt_km(peRawCdv),   bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peDayRaw))

    table.cell(t, 0, 7, "% from 1st Candle",  bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 7, str.tostring(ceFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom1stPct))
    table.cell(t, 2, 7, str.tostring(peFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom1stPct))

    table.cell(t, 0, 8, "% from 2nd Candle",  bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 8, na(ceFrom2ndPct) ? "-" : str.tostring(ceFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom2ndPct))
    table.cell(t, 2, 8, na(peFrom2ndPct) ? "-" : str.tostring(peFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom2ndPct))

// ===== Day vs Current Table =====
unitLabel = rawChartUnit
modeLabel = useRaw ? unitLabel : "%"

f_fmt_chart(v) =>
    useRaw ? (str.tostring(v / rawDiv, "#.00") + unitLabel) : (str.tostring(v, "#.00") + "%")

ceDayChangePct = not na(cePrevDayClose) and math.abs(cePrevDayClose) > 0 ? ((ceActive - cePrevDayClose) / math.abs(cePrevDayClose)) * 100 : na
peDayChangePct = not na(pePrevDayClose) and math.abs(pePrevDayClose) > 0 ? ((peActive - pePrevDayClose) / math.abs(pePrevDayClose)) * 100 : na

var table t2 = table.new(position.bottom_right, 3, 5, border_width=1)

if barstate.islast and showDayChangeTable
    table.cell(t2, 0, 0, "CDV: Day vs Current (" + modeLabel + ")", bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=size.small)
    table.cell(t2, 1, 0, "CE",                                       bgcolor=color.new(color.navy, 10), text_color=color.lime,  text_size=size.small)
    table.cell(t2, 2, 0, "PE",                                       bgcolor=color.new(color.navy, 10), text_color=color.red,   text_size=size.small)

    table.cell(t2, 0, 1, "Prev Day Close", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(t2, 1, 1, na(cePrevDayClose) ? "No Data" : f_fmt_chart(cePrevDayClose), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(cePrevDayClose), text_size=size.small)
    table.cell(t2, 2, 1, na(pePrevDayClose) ? "No Data" : f_fmt_chart(pePrevDayClose), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(pePrevDayClose), text_size=size.small)

    table.cell(t2, 0, 2, "Today (Live)", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(t2, 1, 2, f_fmt_chart(ceActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(ceActive), text_size=size.small)
    table.cell(t2, 2, 2, f_fmt_chart(peActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(peActive), text_size=size.small)

    table.cell(t2, 0, 3, "% Change (Day)", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=size.small)
    table.cell(t2, 1, 3, na(ceDayChangePct) ? "No Data" : str.tostring(ceDayChangePct, "#.00") + "%", bgcolor=color.new(color.gray, 85), text_color=f_pct_color(ceDayChangePct), text_size=size.small)
    table.cell(t2, 2, 3, na(peDayChangePct) ? "No Data" : str.tostring(peDayChangePct, "#.00") + "%", bgcolor=color.new(color.gray, 85), text_color=f_pct_color(peDayChangePct), text_size=size.small)

    netCdv      = ceActive - peActive
    netCdvLabel = netCdv > 0 ? "BULLISH" : netCdv < 0 ? "BEARISH" : "NEUTRAL"
    netCdvColor = netCdv > 0 ? color.lime  : netCdv < 0 ? color.red  : color.gray
    table.cell(t2, 0, 4, "Net CDV (CE-PE)", bgcolor=color.new(color.gray, 80), text_color=color.white,  text_size=size.small)
    table.cell(t2, 1, 4, f_fmt_chart(netCdv) + "  " + netCdvLabel, bgcolor=color.new(color.gray, 85), text_color=netCdvColor, text_size=size.small)
    table.cell(t2, 2, 4, "", bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=size.small)