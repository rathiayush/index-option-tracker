    ce_atm_buy_sl  := f_sl_buy(ce_atm_p)
    ce_atm_sell_sl := na
if ce_atm_cd
    ce_atm_sell_sl := f_sl_sell(ce_atm_p)
    ce_atm_buy_sl  := na

// CE ATM BUY SL hit: option price (close of CE ATM) drops below SL
if showSLHitTags and not na(ce_atm_buy_sl) and ce_atm_p < ce_atm_buy_sl
    label.new(bar_index, high + y_step, text="SL✂ CE " + str.tostring(ce_atm) + " ATM\n" + str.tostring(ce_atm_buy_sl,"#.0"),
              style=label.style_label_down, color=color.new(color.orange, 0), textcolor=color.white, size=size.tiny)
    ce_atm_buy_sl := na

// CE ATM SELL SL hit: option price rises above SL
if showSLHitTags and not na(ce_atm_sell_sl) and ce_atm_p > ce_atm_sell_sl
    label.new(bar_index, low - y_step, text="SL✂ CE " + str.tostring(ce_atm) + " ATM\n" + str.tostring(ce_atm_sell_sl,"#.0"),
