//@version=5
indicator("OBV Auto with Delta Weighting & Manual Expiry Override", overlay=false, dynamic_requests=true)

// ===== Auto-detect Index from Chart Symbol =====
chartSym  = syminfo.ticker
indexName = str.contains(chartSym, "BANKNIFTY") ? "BANKNIFTY" : str.contains(chartSym, "FINNIFTY") ? "FINNIFTY" : str.contains(chartSym, "MIDCPNIFTY") ? "MIDCPNIFTY" : str.contains(chartSym, "SENSEX") ? "BSX" : str.contains(chartSym, "BANKEX") ? "BANKEX" : str.contains(chartSym, "NIFTY") ? "NIFTY" : input.string("NIFTY", "Index Name (fallback)", options=["NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY", "SENSEX", "BANKEX"])

// ===== Inputs =====
// ===== Frozen Candle: Time-based (IST = Asia/Kolkata, 24-hour HHMM) =====
frozenTimeInput = input.int(1342, "Frozen Candle Time IST (HHMM)", minval=0, maxval=2359, group="Base Settings", tooltip="Enter as HHMM. e.g. 1342 = 13:42 IST, 915 = 09:15 IST")
frozenHour   = math.floor(frozenTimeInput / 100)
frozenMinute = frozenTimeInput - frozenHour * 100

// ===== Percentage Thresholds (separate: Lookback vs Frozen) =====
lookbackPctThreshold = input.float(50.0, "Lookback % Threshold", minval=0.0, step=1.0, group="Base Settings", tooltip="If the % change over the Lookback Bars period is >= this value, the bar/value is highlighted Yellow and an alert fires. Applies to CE and PE independently.")
frozenPctThreshold   = input.float(50.0, "Frozen Bar % Threshold", minval=0.0, step=1.0, group="Base Settings", tooltip="If the % change vs the Frozen Bar is >= this value, the bar/value is highlighted Yellow and an alert fires. Applies to CE and PE independently.")

atmStrike          = input.int(24000, "ATM Strike", group="Base Settings")
smoothLen          = input.int(9, "OBV EMA Length", minval=1, group="Base Settings")
displayMode        = input.string("Raw", "Display Mode", options=["Raw", "Percent"], group="Base Settings")
rawChartUnit       = input.string("K", "Raw Chart Unit", options=["K", "M"], group="Base Settings")
showTable          = input.bool(true, "Show % Change Table", group="Base Settings")
showDayChangeTable = input.bool(true, "Show Day vs Current Table", group="Base Settings")
showResetDebug          = input.bool(false, "Show Daily Reset Marker",          group="Base Settings")
showLbThresholdHighlight = input.bool(false, "Show Lookback Threshold Highlight (Bar BG)", group="Base Settings")
lbThresholdColor         = input.color(color.orange, "Lookback Threshold BG Color", group="Base Settings")
showFcThresholdHighlight = input.bool(false, "Show Frozen Threshold Highlight (Bar BG)", group="Base Settings")
fcThresholdColor         = input.color(color.purple, "Frozen Threshold BG Color", group="Base Settings")
showThresholdArrows     = input.bool(false, "Show Threshold Arrows",              group="Base Settings")
lookbackBars            = input.int(10, "Lookback Bars (Table)", minval=1,        group="Base Settings")

// ===== Multi-Lookback Table Inputs =====
lb1Bars           = input.int(20, "Multi-LB Bar 1", minval=1, maxval=500, group="Multi-Lookback Table", tooltip="First lookback period for the horizontal multi-lookback table (bottom-left).")
lb2Bars           = input.int(25, "Multi-LB Bar 2", minval=1, maxval=500, group="Multi-Lookback Table", tooltip="Second lookback period.")
lb3Bars           = input.int(30, "Multi-LB Bar 3", minval=1, maxval=500, group="Multi-Lookback Table", tooltip="Third lookback period.")
showLookbackTable = input.bool(true, "Show Multi-Lookback Table", group="Multi-Lookback Table")

// ===== Table Font Size =====
tableFontSizeInput = input.string("Small", "Table Font Size", options=["Tiny", "Small", "Normal", "Large", "Huge"], group="Base Settings")
tableFontSize = tableFontSizeInput == "Tiny" ? size.tiny : tableFontSizeInput == "Normal" ? size.normal : tableFontSizeInput == "Large" ? size.large : tableFontSizeInput == "Huge" ? size.huge : size.small

// ===== Delta-Weighting Toggle =====
useDeltaWeighting = input.bool(true, "Use Delta Weighting (Volume × Delta)", group="Base Settings", tooltip="When ON, volume is multiplied by option delta (0-1 for calls, -1-0 for puts)")

// ===== Expiry Override Settings =====
useManualExpiry = input.bool(false, "Use Manual Expiry Code", group="Expiry Override Settings", tooltip="Tick this box to force the script to use the manual expiry code specified below instead of the auto-calculated expiry.")
manualExpiry    = input.string("260528", "Manual Expiry Code (YYMMDD)", group="Expiry Override Settings", tooltip="Example: 260528 represents May 28, 2026. Only active if 'Use Manual Expiry Code' is checked.")

// ===== Auto Strike Step per Index =====
strikeStep = indexName == "BANKNIFTY" ? 100 : indexName == "FINNIFTY" ? 50 : indexName == "MIDCPNIFTY" ? 25 : indexName == "BSX" ? 100 : indexName == "BANKEX" ? 100 : 50

// ===== Auto-fetch Underlying Price =====
f_underlying_sym(_name) =>
    switch _name
        "NIFTY"      => "NSE:NIFTY"
        "BANKNIFTY"  => "NSE:BANKNIFTY"
        "FINNIFTY"   => "NSE:FINNIFTY"
        "MIDCPNIFTY" => "NSE:MIDCPNIFTY"
        "SENSEX"     => "BSE:SENSEX"
        "BANKEX"     => "BSE:BANKEX"
        => "NSE:NIFTY"

underlyingSym   = f_underlying_sym(indexName)
underlyingPrice = request.security(underlyingSym, timeframe.period, close)

// ===== Date Helpers =====
f_2d(n) =>
    int(n) < 10 ? "0" + str.tostring(int(n)) : str.tostring(int(n))

f_expiry_code(yy, mm, dd) =>
    str.tostring(int(yy)) + f_2d(int(mm)) + f_2d(int(dd))

curYear  = year(timenow)
curMonth = month(timenow)
curDay   = dayofmonth(timenow)
curYY    = int(curYear % 100)

// ===== BANKNIFTY: Monthly Expiry =====
f_bnf_expiry_day(mm) =>
    switch mm
        1  => 27
        2  => 24
        3  => 30
        4  => 28
        5  => 26
        6  => 30
        7  => 28
        8  => 25
        9  => 29
        10 => 19
        11 => 23
        12 => 29
        => 28

f_bnf_next_expiry() =>
    mm   = curMonth
    yy   = curYY
    eDay = f_bnf_expiry_day(mm)
    if curDay > eDay
        mm   := mm == 12 ? 1 : mm + 1
        yy   := mm == 1 ? yy + 1 : yy
        eDay := f_bnf_expiry_day(mm)
    f_expiry_code(yy, mm, eDay)

// ===== NIFTY: Weekly Tuesday Expiry (2026 hardcoded) =====
f_nifty_next_expiry() =>
    today_mmdd = curMonth * 100 + curDay
    expiries = array.from(505, 512, 519, 526, 602, 609, 616, 623, 630, 707, 714, 721, 728, 804, 811, 818, 825, 901, 908, 915, 922, 929, 1006, 1013, 1019, 1027, 1103, 1110, 1117, 1124, 1201, 1208, 1215, 1222, 1229)
    picked_mmdd = 1229
    for i = 0 to array.size(expiries) - 1
        val = array.get(expiries, i)
        if today_mmdd <= val
            picked_mmdd := val
            break
    picked_mm = math.floor(picked_mmdd / 100)
    picked_dd = picked_mmdd - (math.floor(picked_mmdd / 100) * 100)
    f_expiry_code(curYY, picked_mm, picked_dd)

// ===== SENSEX / BANKEX: Weekly Thursday Expiry =====
// ===== SENSEX / BANKEX: Weekly Thursday Expiry =====
f_next_thursday_expiry() =>
    dow = dayofweek(timenow, "Asia/Kolkata")
    daysAhead = dow <= 5 ? 5 - dow : 7 - dow + 5
    expiryTs  = timenow + daysAhead * 86400000
    eYY  = int(year(expiryTs, "Asia/Kolkata") % 100)
    eMon = month(expiryTs, "Asia/Kolkata")
    eDay = dayofmonth(expiryTs, "Asia/Kolkata")
    f_expiry_code(eYY, eMon, eDay)

// ===== FINNIFTY / MIDCPNIFTY: Weekly Tuesday Expiry (dynamic) =====
f_next_tuesday_expiry() =>
    dow = dayofweek(timenow, "Asia/Kolkata")
    daysAhead = dow <= 3 ? 3 - dow : 7 - dow + 3
    expiryTs  = timenow + daysAhead * 86400000
    eYY  = int(year(expiryTs, "Asia/Kolkata") % 100)
    eMon = month(expiryTs, "Asia/Kolkata")
    eDay = dayofmonth(expiryTs, "Asia/Kolkata")
    f_expiry_code(eYY, eMon, eDay)

// ===== Route Expiry by Index =====
autoExpiry = indexName == "BANKNIFTY" ? f_bnf_next_expiry() : indexName == "NIFTY" ? f_nifty_next_expiry() : indexName == "BSX" ? f_next_thursday_expiry() : indexName == "BANKEX" ? f_next_thursday_expiry() : f_next_tuesday_expiry()
expiryCode = useManualExpiry ? manualExpiry : autoExpiry

// ===== Symbol Builder =====
f_sym(_strike, _isCall) =>
    prefix = indexName == "SENSEX" ? "BSX" : str.upper(indexName)
    prefix + expiryCode + (_isCall ? "C" : "P") + str.tostring(int(_strike))

// ===== Delta Calculation =====
f_get_delta(_strike, _isCall, _spot) =>
    moneyness = (_strike - _spot) / _spot
    if _isCall
        1 / (1 + math.exp(-1.7 * -moneyness * 5))
    else
        -1 / (1 + math.exp(-1.7 * moneyness * 5))

f_bar_obv_with_delta(_delta) =>
    math.sign(ta.change(close)) * volume * _delta

f_bar_obv_standard() =>
    math.sign(ta.change(close)) * volume

f_obv(_sym, _strike, _isCall, _spot) =>
    deltaWeight = useDeltaWeighting ? math.abs(f_get_delta(_strike, _isCall, _spot)) : 1.0
    request.security(_sym, timeframe.period, ta.cum(useDeltaWeighting ? f_bar_obv_with_delta(deltaWeight) : f_bar_obv_standard()), lookahead=barmerge.lookahead_off)

currentSpot = underlyingPrice

// ===== Strike Levels =====
ce_s8 = atmStrike - 8 * strikeStep
ce_s7 = atmStrike - 7 * strikeStep
ce_s6 = atmStrike - 6 * strikeStep
ce_s5 = atmStrike - 5 * strikeStep
ce_s4 = atmStrike - 4 * strikeStep
ce_s3 = atmStrike - 3 * strikeStep
ce_s2 = atmStrike - 2 * strikeStep
ce_s1 = atmStrike - 1 * strikeStep
ce_s0 = atmStrike
ce_p1 = atmStrike + 1 * strikeStep
ce_p2 = atmStrike + 2 * strikeStep
ce_p3 = atmStrike + 3 * strikeStep
ce_p4 = atmStrike + 4 * strikeStep
ce_p5 = atmStrike + 5 * strikeStep
ce_p6 = atmStrike + 6 * strikeStep
ce_p7 = atmStrike + 7 * strikeStep

pe_s8 = atmStrike - 8 * strikeStep
pe_s7 = atmStrike - 7 * strikeStep
pe_s6 = atmStrike - 6 * strikeStep
pe_s5 = atmStrike - 5 * strikeStep
pe_s4 = atmStrike - 4 * strikeStep
pe_s3 = atmStrike - 3 * strikeStep
pe_s2 = atmStrike - 2 * strikeStep
pe_s1 = atmStrike - 1 * strikeStep
pe_s0 = atmStrike
pe_p1 = atmStrike + 1 * strikeStep
pe_p2 = atmStrike + 2 * strikeStep
pe_p3 = atmStrike + 3 * strikeStep
pe_p4 = atmStrike + 4 * strikeStep
pe_p5 = atmStrike + 5 * strikeStep
pe_p6 = atmStrike + 6 * strikeStep
pe_p7 = atmStrike + 7 * strikeStep

// ===== OBV Aggregation =====
ceRawObv = nz(f_obv(f_sym(ce_s8, true), ce_s8, true, currentSpot)) + nz(f_obv(f_sym(ce_s7, true), ce_s7, true, currentSpot)) + nz(f_obv(f_sym(ce_s6, true), ce_s6, true, currentSpot)) + nz(f_obv(f_sym(ce_s5, true), ce_s5, true, currentSpot)) + nz(f_obv(f_sym(ce_s4, true), ce_s4, true, currentSpot)) + nz(f_obv(f_sym(ce_s3, true), ce_s3, true, currentSpot)) + nz(f_obv(f_sym(ce_s2, true), ce_s2, true, currentSpot)) + nz(f_obv(f_sym(ce_s1, true), ce_s1, true, currentSpot)) + nz(f_obv(f_sym(ce_s0, true), ce_s0, true, currentSpot)) + nz(f_obv(f_sym(ce_p1, true), ce_p1, true, currentSpot)) + nz(f_obv(f_sym(ce_p2, true), ce_p2, true, currentSpot)) + nz(f_obv(f_sym(ce_p3, true), ce_p3, true, currentSpot)) + nz(f_obv(f_sym(ce_p4, true), ce_p4, true, currentSpot)) + nz(f_obv(f_sym(ce_p5, true), ce_p5, true, currentSpot)) + nz(f_obv(f_sym(ce_p6, true), ce_p6, true, currentSpot)) + nz(f_obv(f_sym(ce_p7, true), ce_p7, true, currentSpot))

peRawObv = nz(f_obv(f_sym(pe_s8, false), pe_s8, false, currentSpot)) + nz(f_obv(f_sym(pe_s7, false), pe_s7, false, currentSpot)) + nz(f_obv(f_sym(pe_s6, false), pe_s6, false, currentSpot)) + nz(f_obv(f_sym(pe_s5, false), pe_s5, false, currentSpot)) + nz(f_obv(f_sym(pe_s4, false), pe_s4, false, currentSpot)) + nz(f_obv(f_sym(pe_s3, false), pe_s3, false, currentSpot)) + nz(f_obv(f_sym(pe_s2, false), pe_s2, false, currentSpot)) + nz(f_obv(f_sym(pe_s1, false), pe_s1, false, currentSpot)) + nz(f_obv(f_sym(pe_s0, false), pe_s0, false, currentSpot)) + nz(f_obv(f_sym(pe_p1, false), pe_p1, false, currentSpot)) + nz(f_obv(f_sym(pe_p2, false), pe_p2, false, currentSpot)) + nz(f_obv(f_sym(pe_p3, false), pe_p3, false, currentSpot)) + nz(f_obv(f_sym(pe_p4, false), pe_p4, false, currentSpot)) + nz(f_obv(f_sym(pe_p5, false), pe_p5, false, currentSpot)) + nz(f_obv(f_sym(pe_p6, false), pe_p6, false, currentSpot)) + nz(f_obv(f_sym(pe_p7, false), pe_p7, false, currentSpot))

// ===== Day Opening Candle Baseline =====
isNewDay = ta.change(time("D")) != 0

var float ceBase          = na
var float peBase          = na
var float ceSecondBase    = na
var float peSecondBase    = na
var int   dayCandleNo     = 0
var float cePrevDayClose  = na
var float pePrevDayClose  = na
var float ceFrozenVal     = na
var float peFrozenVal     = na
var bool  resetNow        = false

resetNow := false

if isNewDay
    ceBase       := na
    peBase       := na
    ceSecondBase := na
    peSecondBase := na
    ceFrozenVal  := na
    peFrozenVal  := na
    dayCandleNo  := 0
    resetNow     := true

if barstate.isconfirmed
    dayCandleNo += 1
    if dayCandleNo == 1
        ceBase := ceRawObv
        peBase := peRawObv
    if dayCandleNo == 2
        ceSecondBase := ceRawObv
        peSecondBase := peRawObv

// ===== Frozen Candle: IST Time-based Detection =====
// Uses Asia/Kolkata (IST = UTC+5:30). Checks if target time falls within this bar's window.
barOpenMs   = hour(time, "Asia/Kolkata") * 3600000 + minute(time, "Asia/Kolkata") * 60000
targetMs    = frozenHour * 3600000 + frozenMinute * 60000
tfMs        = timeframe.in_seconds() * 1000
isFrozenTime = barOpenMs <= targetMs and targetMs < barOpenMs + tfMs

plotshape(showResetDebug and resetNow, title="Daily Baseline Reset", style=shape.labeldown, location=location.top, color=color.yellow, textcolor=color.black, text="RESET", size=size.tiny)
plotshape(barstate.isconfirmed and isFrozenTime, title="Frozen Candle Marker", style=shape.labeldown, location=location.top, color=color.teal, textcolor=color.white, text="FC", size=size.normal)

// ===== Delta from Baselines =====
ceDayRaw     = ceRawObv - nz(ceBase, ceRawObv)
peDayRaw     = peRawObv - nz(peBase, peRawObv)
ceFrom1stRaw = ceDayRaw
peFrom1stRaw = peDayRaw
ceFrom2ndRaw = not na(ceSecondBase) ? ceRawObv - ceSecondBase : na
peFrom2ndRaw = not na(peSecondBase) ? peRawObv - peSecondBase : na

ceFrom1stPct = math.abs(nz(ceBase)) > 0 ? (ceFrom1stRaw / math.abs(ceBase)) * 100 : 0.0
peFrom1stPct = math.abs(nz(peBase)) > 0 ? (peFrom1stRaw / math.abs(peBase)) * 100 : 0.0
ceFrom2ndPct = not na(ceSecondBase) and math.abs(ceSecondBase) > 0 ? (ceFrom2ndRaw / math.abs(ceSecondBase)) * 100 : na
peFrom2ndPct = not na(peSecondBase) and math.abs(peSecondBase) > 0 ? (peFrom2ndRaw / math.abs(peSecondBase)) * 100 : na

ceRawEma = ta.ema(ceFrom1stRaw, smoothLen)
peRawEma = ta.ema(peFrom1stRaw, smoothLen)
cePctEma = ta.ema(ceFrom1stPct, smoothLen)
pePctEma = ta.ema(peFrom1stPct, smoothLen)

useRaw   = displayMode == "Raw"
ceActive = useRaw ? ceRawEma : cePctEma
peActive = useRaw ? peRawEma : pePctEma

// ===== Frozen Candle Capture (UTC time match, after ceActive is computed) =====
if barstate.isconfirmed and isFrozenTime
    ceFrozenVal := ceActive
    peFrozenVal := peActive

if isNewDay
    cePrevDayClose := ceActive[1]
    pePrevDayClose := peActive[1]

rawDiv     = rawChartUnit == "M" ? 1000000.0 : 1000.0
ceRawChart = ceRawEma / rawDiv
peRawChart = peRawEma / rawDiv

crossUp   = ta.crossover(ceActive, peActive)
crossDown = ta.crossunder(ceActive, peActive)

// ===== Lookback Bars Computation =====
ceLookbackVal       = ceActive[lookbackBars]
peLookbackVal       = peActive[lookbackBars]
ceLookbackChangePct = not na(ceLookbackVal) and math.abs(ceLookbackVal) > 0 ? ((ceActive - ceLookbackVal) / math.abs(ceLookbackVal)) * 100 : na
peLookbackChangePct = not na(peLookbackVal) and math.abs(peLookbackVal) > 0 ? ((peActive - peLookbackVal) / math.abs(peLookbackVal)) * 100 : na

// ===== Frozen Candle Change Computation =====
ceFrozenChangePct = not na(ceFrozenVal) and math.abs(ceFrozenVal) > 0 ? ((ceActive - ceFrozenVal) / math.abs(ceFrozenVal)) * 100 : na
peFrozenChangePct = not na(peFrozenVal) and math.abs(peFrozenVal) > 0 ? ((peActive - peFrozenVal) / math.abs(peFrozenVal)) * 100 : na

// ===== Percentage Threshold Detection (Lookback + Frozen, CE & PE independent) =====
ceLbHit = not na(ceLookbackChangePct) and math.abs(ceLookbackChangePct) >= lookbackPctThreshold
peLbHit = not na(peLookbackChangePct) and math.abs(peLookbackChangePct) >= lookbackPctThreshold
ceFcHit = not na(ceFrozenChangePct) and math.abs(ceFrozenChangePct) >= frozenPctThreshold
peFcHit = not na(peFrozenChangePct) and math.abs(peFrozenChangePct) >= frozenPctThreshold
anyThresholdHit = ceLbHit or peLbHit or ceFcHit or peFcHit

// Yellow bar highlight when any threshold condition is met
bgcolor(showLbThresholdHighlight and (ceLbHit or peLbHit) ? color.new(lbThresholdColor, 70) : na, title="Lookback Threshold Highlight")
bgcolor(showFcThresholdHighlight and (ceFcHit or peFcHit) ? color.new(fcThresholdColor, 70) : na, title="Frozen Threshold Highlight")

lbThLabel = str.tostring(lookbackPctThreshold, "#.0") + "%"
fcThLabel = str.tostring(frozenPctThreshold, "#.0") + "%"
fcTimeTxt = str.tostring(frozenHour) + ":" + f_2d(frozenMinute) + " IST"

plotshape(showThresholdArrows and (ceLbHit or ceFcHit), title="CE Threshold Hit", style=shape.triangleup, location=location.top, color=color.yellow, size=size.tiny)
plotshape(showThresholdArrows and (peLbHit or peFcHit), title="PE Threshold Hit", style=shape.triangledown, location=location.bottom, color=color.yellow, size=size.tiny)

// ===== Alerts =====
f_json(txt) =>
    str.replace_all(str.replace_all(txt, "\n", "\\n"), '"', '\\"')

f_webhook_payload(_html_text) =>
    '{"chat_id":"-1003533948678","parse_mode":"HTML","text":"' + f_json(_html_text) + '"}'

lbHitAny = ceLbHit or peLbHit
fcHitAny = ceFcHit or peFcHit

if barstate.isconfirmed and lbHitAny and not lbHitAny[1]
    msg_html = "<b>OBV LOOKBACK THRESHOLD ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> Lookback % change (>= " + lbThLabel + ") over last " + str.tostring(lookbackBars) + " bars\n<b>CE:</b> " + str.tostring(ceLookbackChangePct, "#.00") + "% | <b>PE:</b> " + str.tostring(peLookbackChangePct, "#.00") + "%"
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and fcHitAny and not fcHitAny[1]
    msg_html = "<b>OBV FROZEN BAR THRESHOLD ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> Frozen Bar % change (>= " + fcThLabel + ") vs " + fcTimeTxt + "\n<b>CE:</b> " + str.tostring(ceFrozenChangePct, "#.00") + "% | <b>PE:</b> " + str.tostring(peFrozenChangePct, "#.00") + "%"
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and crossUp
    modeTxt  = useRaw ? "Raw" : "Percent"
    deltaTxt = useDeltaWeighting ? " (Delta-Weighted)" : ""
    msg_html = "<b>OBV CE/PE CROSS ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Mode:</b> " + modeTxt + deltaTxt + "\n<b>Event:</b> Green crossed Red (BULL)\n<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and crossDown
    modeTxt  = useRaw ? "Raw" : "Percent"
    deltaTxt = useDeltaWeighting ? " (Delta-Weighted)" : ""
    msg_html = "<b>OBV CE/PE CROSS ALERT</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Mode:</b> " + modeTxt + deltaTxt + "\n<b>Event:</b> Red crossed Green (BEAR)\n<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

// ===== Percentage Threshold Alerts (fire on the bar the condition first becomes true) =====
if barstate.isconfirmed and ceLbHit and not ceLbHit[1]
    msg_html = "<b>OBV THRESHOLD ALERT (CE)</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> CE changed " + str.tostring(ceLookbackChangePct, "#.00") + "% over last " + str.tostring(lookbackBars) + " bars (>= " + lbThLabel + ")\n<b>CE:</b> " + str.tostring(ceActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and peLbHit and not peLbHit[1]
    msg_html = "<b>OBV THRESHOLD ALERT (PE)</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> PE changed " + str.tostring(peLookbackChangePct, "#.00") + "% over last " + str.tostring(lookbackBars) + " bars (>= " + lbThLabel + ")\n<b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and ceFcHit and not ceFcHit[1]
    msg_html = "<b>OBV FROZEN BAR THRESHOLD ALERT (CE)</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> CE changed " + str.tostring(ceFrozenChangePct, "#.00") + "% vs Frozen Bar (" + fcTimeTxt + ") (>= " + fcThLabel + ")\n<b>CE:</b> " + str.tostring(ceActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and peFcHit and not peFcHit[1]
    msg_html = "<b>OBV FROZEN BAR THRESHOLD ALERT (PE)</b>\n<b>" + indexName + "</b> | TF:" + timeframe.period + "\n<b>Event:</b> PE changed " + str.tostring(peFrozenChangePct, "#.00") + "% vs Frozen Bar (" + fcTimeTxt + ") (>= " + fcThLabel + ")\n<b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

// ===== Plot =====
plot(0, "Opening Candle Baseline", color=color.new(color.gray, 20), linewidth=1, style=plot.style_line)
plot(useRaw ? ceRawChart : na, "CE OBV Raw", color=color.new(color.lime, 0), linewidth=2)
plot(useRaw ? peRawChart : na, "PE OBV Raw", color=color.new(color.red, 0), linewidth=2)

// ===== Table =====
f_pct_color(v) =>
    na(v) ? color.new(color.gray, 0) : v > 0 ? color.new(color.lime, 0) : v < 0 ? color.new(color.red, 0) : color.new(color.gray, 0)

f_fmt_km(v) =>
    av = math.abs(v)
    av >= 1000000 ? str.tostring(v / 1000000, "#.00") + "M" : av >= 1000 ? str.tostring(v / 1000, "#.00") + "K" : str.tostring(v, "#.0")

var table t = table.new(position.top_right, 3, 10, border_width=1)

if barstate.islast and showTable
    table.cell(t, 0, 0, "Metric",             bgcolor=color.new(color.silver, 15), text_color=color.black, text_size=tableFontSize)
    table.cell(t, 1, 0, "CE",                 bgcolor=color.new(color.silver, 15), text_color=color.black, text_size=tableFontSize)
    table.cell(t, 2, 0, "PE",                 bgcolor=color.new(color.silver, 15), text_color=color.black, text_size=tableFontSize)

    table.cell(t, 0, 1, indexName + " Price", bgcolor=color.new(color.navy, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 1, str.tostring(underlyingPrice, "#.00"), bgcolor=color.new(color.navy, 70), text_color=color.yellow, text_size=tableFontSize)
    table.cell(t, 2, 1, "Chart: " + chartSym, bgcolor=color.new(color.navy, 70), text_color=color.silver, text_size=tableFontSize)

    table.cell(t, 0, 2, "ATM | Expiry",       bgcolor=color.new(color.navy, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 2, str.tostring(int(atmStrike)), bgcolor=color.new(color.navy, 70), text_color=color.yellow, text_size=tableFontSize)
    table.cell(t, 2, 2, expiryCode,           bgcolor=color.new(color.navy, 70), text_color=color.yellow, text_size=tableFontSize)

    table.cell(t, 0, 3, "Delta Weighting",    bgcolor=color.new(color.navy, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 3, useDeltaWeighting ? "ON" : "OFF", bgcolor=color.new(color.navy, 70), text_color=useDeltaWeighting ? color.lime : color.red, text_size=tableFontSize)
    table.cell(t, 2, 3, "",                   bgcolor=color.new(color.navy, 70), text_color=color.white, text_size=tableFontSize)

    table.cell(t, 0, 4, "1st Candle Raw",     bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 4, f_fmt_km(ceBase),     bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 2, 4, f_fmt_km(peBase),     bgcolor=color.new(color.gray, 90), text_color=color.white, text_size=tableFontSize)

    table.cell(t, 0, 5, "2nd Candle Raw",     bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 5, na(ceSecondBase) ? "Waiting" : f_fmt_km(ceSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(ceSecondBase) ? color.orange : color.white, text_size=tableFontSize)
    table.cell(t, 2, 5, na(peSecondBase) ? "Waiting" : f_fmt_km(peSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(peSecondBase) ? color.orange : color.white, text_size=tableFontSize)

    table.cell(t, 0, 6, "Current Raw",        bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 6, f_fmt_km(ceRawObv),   bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceDayRaw), text_size=tableFontSize)
    table.cell(t, 2, 6, f_fmt_km(peRawObv),   bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peDayRaw), text_size=tableFontSize)

    table.cell(t, 0, 7, "% from 1st candle",  bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 7, str.tostring(ceFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom1stPct), text_size=tableFontSize)
    table.cell(t, 2, 7, str.tostring(peFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom1stPct), text_size=tableFontSize)

    table.cell(t, 0, 8, "% from 2nd candle",  bgcolor=color.new(color.gray, 85), text_color=color.white, text_size=tableFontSize)
    table.cell(t, 1, 8, na(ceFrom2ndPct) ? "-" : str.tostring(ceFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom2ndPct), text_size=tableFontSize)
    table.cell(t, 2, 8, na(peFrom2ndPct) ? "-" : str.tostring(peFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom2ndPct), text_size=tableFontSize)

// ===== Day vs Current Table =====
unitLabel = rawChartUnit
modeLabel = useRaw ? unitLabel : "%"

f_fmt_chart(v) =>
    useRaw ? (str.tostring(v / rawDiv, "#.00") + unitLabel) : (str.tostring(v, "#.00") + "%")

ceDayChangePct = not na(cePrevDayClose) and math.abs(cePrevDayClose) > 0 ? ((ceActive - cePrevDayClose) / math.abs(cePrevDayClose)) * 100 : na
peDayChangePct = not na(pePrevDayClose) and math.abs(pePrevDayClose) > 0 ? ((peActive - pePrevDayClose) / math.abs(pePrevDayClose)) * 100 : na

// t2: 8 rows
var table t2 = table.new(position.bottom_right, 3, 8, border_width=1)

if barstate.islast and showDayChangeTable
    lbLabel = "±" + str.tostring(lookbackBars) + "B"
    fcLabel = "FC " + str.tostring(frozenHour) + ":" + f_2d(frozenMinute) + "IST"

    table.cell(t2, 0, 0, "OBV: Day vs Current (" + modeLabel + ")", bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 0, "CE",                                       bgcolor=color.new(color.navy, 10), text_color=color.lime,  text_size=tableFontSize)
    table.cell(t2, 2, 0, "PE",                                       bgcolor=color.new(color.navy, 10), text_color=color.red,   text_size=tableFontSize)

    table.cell(t2, 0, 1, "Prev Day Close", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 1, na(cePrevDayClose) ? "No Data" : f_fmt_chart(cePrevDayClose), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(cePrevDayClose), text_size=tableFontSize)
    table.cell(t2, 2, 1, na(pePrevDayClose) ? "No Data" : f_fmt_chart(pePrevDayClose), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(pePrevDayClose), text_size=tableFontSize)

    table.cell(t2, 0, 2, "Today (Live)", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 2, f_fmt_chart(ceActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(ceActive), text_size=tableFontSize)
    table.cell(t2, 2, 2, f_fmt_chart(peActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(peActive), text_size=tableFontSize)

    table.cell(t2, 0, 3, "% Change (Day)", bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 3, na(ceDayChangePct) ? "No Data" : str.tostring(ceDayChangePct, "#.00") + "%", bgcolor=color.new(color.gray, 85), text_color=f_pct_color(ceDayChangePct), text_size=tableFontSize)
    table.cell(t2, 2, 3, na(peDayChangePct) ? "No Data" : str.tostring(peDayChangePct, "#.00") + "%", bgcolor=color.new(color.gray, 85), text_color=f_pct_color(peDayChangePct), text_size=tableFontSize)

    table.cell(t2, 0, 4, lbLabel + " Ago (Val)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 4, na(ceLookbackVal) ? "No Data" : f_fmt_chart(ceLookbackVal), bgcolor=ceLbHit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLbHit ? color.black : f_pct_color(ceLookbackVal), text_size=tableFontSize)
    table.cell(t2, 2, 4, na(peLookbackVal) ? "No Data" : f_fmt_chart(peLookbackVal), bgcolor=peLbHit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLbHit ? color.black : f_pct_color(peLookbackVal), text_size=tableFontSize)

    table.cell(t2, 0, 5, "Chg " + lbLabel + " (Live)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 5, na(ceLookbackChangePct) ? "No Data" : str.tostring(ceLookbackChangePct, "#.00") + "%", bgcolor=ceLbHit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLbHit ? color.black : f_pct_color(ceLookbackChangePct), text_size=tableFontSize)
    table.cell(t2, 2, 5, na(peLookbackChangePct) ? "No Data" : str.tostring(peLookbackChangePct, "#.00") + "%", bgcolor=peLbHit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLbHit ? color.black : f_pct_color(peLookbackChangePct), text_size=tableFontSize)

    table.cell(t2, 0, 6, fcLabel + " Val", bgcolor=color.new(color.teal, 50), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 6, na(ceFrozenVal) ? "Waiting" : f_fmt_chart(ceFrozenVal), bgcolor=ceFcHit ? color.new(color.yellow, 0) : color.new(color.teal, 60), text_color=ceFcHit ? color.black : na(ceFrozenVal) ? color.orange : f_pct_color(ceFrozenVal), text_size=tableFontSize)
    table.cell(t2, 2, 6, na(peFrozenVal) ? "Waiting" : f_fmt_chart(peFrozenVal), bgcolor=peFcHit ? color.new(color.yellow, 0) : color.new(color.teal, 60), text_color=peFcHit ? color.black : na(peFrozenVal) ? color.orange : f_pct_color(peFrozenVal), text_size=tableFontSize)

    table.cell(t2, 0, 7, "Chg " + fcLabel, bgcolor=color.new(color.teal, 50), text_color=color.white, text_size=tableFontSize)
    table.cell(t2, 1, 7, na(ceFrozenChangePct) ? "Waiting" : str.tostring(ceFrozenChangePct, "#.00") + "%", bgcolor=ceFcHit ? color.new(color.yellow, 0) : color.new(color.teal, 60), text_color=ceFcHit ? color.black : na(ceFrozenChangePct) ? color.orange : f_pct_color(ceFrozenChangePct), text_size=tableFontSize)
    table.cell(t2, 2, 7, na(peFrozenChangePct) ? "Waiting" : str.tostring(peFrozenChangePct, "#.00") + "%", bgcolor=peFcHit ? color.new(color.yellow, 0) : color.new(color.teal, 60), text_color=peFcHit ? color.black : na(peFrozenChangePct) ? color.orange : f_pct_color(peFrozenChangePct), text_size=tableFontSize)

// ===== Multi-Lookback Horizontal Table =====
ceLb1Val = ceActive[lb1Bars]
peLb1Val = peActive[lb1Bars]
ceLb2Val = ceActive[lb2Bars]
peLb2Val = peActive[lb2Bars]
ceLb3Val = ceActive[lb3Bars]
peLb3Val = peActive[lb3Bars]

ceLb1Chg = not na(ceLb1Val) and math.abs(ceLb1Val) > 0 ? ((ceActive - ceLb1Val) / math.abs(ceLb1Val)) * 100 : na
peLb1Chg = not na(peLb1Val) and math.abs(peLb1Val) > 0 ? ((peActive - peLb1Val) / math.abs(peLb1Val)) * 100 : na
ceLb2Chg = not na(ceLb2Val) and math.abs(ceLb2Val) > 0 ? ((ceActive - ceLb2Val) / math.abs(ceLb2Val)) * 100 : na
peLb2Chg = not na(peLb2Val) and math.abs(peLb2Val) > 0 ? ((peActive - peLb2Val) / math.abs(peLb2Val)) * 100 : na
ceLb3Chg = not na(ceLb3Val) and math.abs(ceLb3Val) > 0 ? ((ceActive - ceLb3Val) / math.abs(ceLb3Val)) * 100 : na
peLb3Chg = not na(peLb3Val) and math.abs(peLb3Val) > 0 ? ((peActive - peLb3Val) / math.abs(peLb3Val)) * 100 : na

ceLb1Hit = not na(ceLb1Chg) and math.abs(ceLb1Chg) >= lookbackPctThreshold
peLb1Hit = not na(peLb1Chg) and math.abs(peLb1Chg) >= lookbackPctThreshold
ceLb2Hit = not na(ceLb2Chg) and math.abs(ceLb2Chg) >= lookbackPctThreshold
peLb2Hit = not na(peLb2Chg) and math.abs(peLb2Chg) >= lookbackPctThreshold
ceLb3Hit = not na(ceLb3Chg) and math.abs(ceLb3Chg) >= lookbackPctThreshold
peLb3Hit = not na(peLb3Chg) and math.abs(peLb3Chg) >= lookbackPctThreshold

// t3: 3 cols (Label | CE | PE) x 8 rows — same vertical style as t2, placed bottom_left
var table t3 = table.new(position.bottom_left, 3, 8, border_width=1)

if barstate.islast and showLookbackTable
    lb1Lbl = "±" + str.tostring(lb1Bars) + "B"
    lb2Lbl = "±" + str.tostring(lb2Bars) + "B"
    lb3Lbl = "±" + str.tostring(lb3Bars) + "B"

    // Header
    table.cell(t3, 0, 0, "OBV Multi-Lookback (" + modeLabel + ")", bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 0, "CE",                                      bgcolor=color.new(color.navy, 10), text_color=color.lime,  text_size=tableFontSize)
    table.cell(t3, 2, 0, "PE",                                      bgcolor=color.new(color.navy, 10), text_color=color.red,   text_size=tableFontSize)

    // Live
    table.cell(t3, 0, 1, "Today (Live)",        bgcolor=color.new(color.gray, 80), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 1, f_fmt_chart(ceActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(ceActive), text_size=tableFontSize)
    table.cell(t3, 2, 1, f_fmt_chart(peActive), bgcolor=color.new(color.gray, 85), text_color=f_pct_color(peActive), text_size=tableFontSize)

    // LB1 Val
    table.cell(t3, 0, 2, lb1Lbl + " Ago (Val)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 2, na(ceLb1Val) ? "No Data" : f_fmt_chart(ceLb1Val), bgcolor=ceLb1Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb1Hit ? color.black : f_pct_color(ceLb1Val), text_size=tableFontSize)
    table.cell(t3, 2, 2, na(peLb1Val) ? "No Data" : f_fmt_chart(peLb1Val), bgcolor=peLb1Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb1Hit ? color.black : f_pct_color(peLb1Val), text_size=tableFontSize)

    // LB1 Chg
    table.cell(t3, 0, 3, "Chg " + lb1Lbl + " (Live)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 3, na(ceLb1Chg) ? "No Data" : str.tostring(ceLb1Chg, "#.00") + "%", bgcolor=ceLb1Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb1Hit ? color.black : f_pct_color(ceLb1Chg), text_size=tableFontSize)
    table.cell(t3, 2, 3, na(peLb1Chg) ? "No Data" : str.tostring(peLb1Chg, "#.00") + "%", bgcolor=peLb1Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb1Hit ? color.black : f_pct_color(peLb1Chg), text_size=tableFontSize)

    // LB2 Val
    table.cell(t3, 0, 4, lb2Lbl + " Ago (Val)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 4, na(ceLb2Val) ? "No Data" : f_fmt_chart(ceLb2Val), bgcolor=ceLb2Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb2Hit ? color.black : f_pct_color(ceLb2Val), text_size=tableFontSize)
    table.cell(t3, 2, 4, na(peLb2Val) ? "No Data" : f_fmt_chart(peLb2Val), bgcolor=peLb2Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb2Hit ? color.black : f_pct_color(peLb2Val), text_size=tableFontSize)

    // LB2 Chg
    table.cell(t3, 0, 5, "Chg " + lb2Lbl + " (Live)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 5, na(ceLb2Chg) ? "No Data" : str.tostring(ceLb2Chg, "#.00") + "%", bgcolor=ceLb2Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb2Hit ? color.black : f_pct_color(ceLb2Chg), text_size=tableFontSize)
    table.cell(t3, 2, 5, na(peLb2Chg) ? "No Data" : str.tostring(peLb2Chg, "#.00") + "%", bgcolor=peLb2Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb2Hit ? color.black : f_pct_color(peLb2Chg), text_size=tableFontSize)

    // LB3 Val
    table.cell(t3, 0, 6, lb3Lbl + " Ago (Val)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 6, na(ceLb3Val) ? "No Data" : f_fmt_chart(ceLb3Val), bgcolor=ceLb3Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb3Hit ? color.black : f_pct_color(ceLb3Val), text_size=tableFontSize)
    table.cell(t3, 2, 6, na(peLb3Val) ? "No Data" : f_fmt_chart(peLb3Val), bgcolor=peLb3Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb3Hit ? color.black : f_pct_color(peLb3Val), text_size=tableFontSize)

    // LB3 Chg
    table.cell(t3, 0, 7, "Chg " + lb3Lbl + " (Live)", bgcolor=color.new(color.maroon, 60), text_color=color.white, text_size=tableFontSize)
    table.cell(t3, 1, 7, na(ceLb3Chg) ? "No Data" : str.tostring(ceLb3Chg, "#.00") + "%", bgcolor=ceLb3Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=ceLb3Hit ? color.black : f_pct_color(ceLb3Chg), text_size=tableFontSize)
    table.cell(t3, 2, 7, na(peLb3Chg) ? "No Data" : str.tostring(peLb3Chg, "#.00") + "%", bgcolor=peLb3Hit ? color.new(color.yellow, 0) : color.new(color.maroon, 70), text_color=peLb3Hit ? color.black : f_pct_color(peLb3Chg), text_size=tableFontSize)