//@version=5
indicator("OBV CE/PE 10-Strike Baseline Graph", overlay=false, dynamic_requests=true)

// ===== Inputs =====
indexName    = input.string("NIFTY", "Index Name", options=["NIFTY", "BANKNIFTY", "FINNIFTY", "MIDCPNIFTY", "BSX", "BANKEX"])
expiryCode   = input.string("23MAR", "Expiry Code (example: 23MAR)")
atmStrike    = input.int(23500, "ATM Strike")
strikeStep   = input.int(50, "Strike Step")
smoothLen    = input.int(9, "OBV EMA Length", minval=1)
displayMode  = input.string("Raw", "Display Mode", options=["Raw", "Percent"])
showTable    = input.bool(true, "Show % Change Table")
showResetDebug = input.bool(false, "Show Daily Reset Marker")

// ===== Helpers =====
f_sym(_strike, _isCall) =>
    indexName + expiryCode + (_isCall ? "C" : "P") + str.tostring(_strike)

f_obv(_sym) =>
    request.security(_sym, timeframe.period, ta.cum(math.sign(ta.change(close)) * volume))

// ===== Strike Aggregation (Fixed 10 CE + 10 PE) =====
ce_s5 = atmStrike - (5 * strikeStep)
ce_s4 = atmStrike - (4 * strikeStep)
ce_s3 = atmStrike - (3 * strikeStep)
ce_s2 = atmStrike - (2 * strikeStep)
ce_s1 = atmStrike - (1 * strikeStep)
ce_s0 = atmStrike
ce_p1 = atmStrike + (1 * strikeStep)
ce_p2 = atmStrike + (2 * strikeStep)
ce_p3 = atmStrike + (3 * strikeStep)
ce_p4 = atmStrike + (4 * strikeStep)

pe_s5 = atmStrike - (5 * strikeStep)
pe_s4 = atmStrike - (4 * strikeStep)
pe_s3 = atmStrike - (3 * strikeStep)
pe_s2 = atmStrike - (2 * strikeStep)
pe_s1 = atmStrike - (1 * strikeStep)
pe_s0 = atmStrike
pe_p1 = atmStrike + (1 * strikeStep)
pe_p2 = atmStrike + (2 * strikeStep)
pe_p3 = atmStrike + (3 * strikeStep)
pe_p4 = atmStrike + (4 * strikeStep)

ceRawObv = 0.0
ceRawObv += nz(f_obv(f_sym(ce_s5, true)))
ceRawObv += nz(f_obv(f_sym(ce_s4, true)))
ceRawObv += nz(f_obv(f_sym(ce_s3, true)))
ceRawObv += nz(f_obv(f_sym(ce_s2, true)))
ceRawObv += nz(f_obv(f_sym(ce_s1, true)))
ceRawObv += nz(f_obv(f_sym(ce_s0, true)))
ceRawObv += nz(f_obv(f_sym(ce_p1, true)))
ceRawObv += nz(f_obv(f_sym(ce_p2, true)))
ceRawObv += nz(f_obv(f_sym(ce_p3, true)))
ceRawObv += nz(f_obv(f_sym(ce_p4, true)))

peRawObv = 0.0
peRawObv += nz(f_obv(f_sym(pe_s5, false)))
peRawObv += nz(f_obv(f_sym(pe_s4, false)))
peRawObv += nz(f_obv(f_sym(pe_s3, false)))
peRawObv += nz(f_obv(f_sym(pe_s2, false)))
peRawObv += nz(f_obv(f_sym(pe_s1, false)))
peRawObv += nz(f_obv(f_sym(pe_s0, false)))
peRawObv += nz(f_obv(f_sym(pe_p1, false)))
peRawObv += nz(f_obv(f_sym(pe_p2, false)))
peRawObv += nz(f_obv(f_sym(pe_p3, false)))
peRawObv += nz(f_obv(f_sym(pe_p4, false)))

// ===== Day Opening Candle Baseline (FIXED) =====
isNewDay = ta.change(time("D")) != 0

var float ceBase       = na
var float peBase       = na
var float ceSecondBase = na
var float peSecondBase = na
var int   dayCandleNo  = 0  // start at 0; incremented on confirmed close

var bool resetNow = false
resetNow := false

// Reset vars at the first bar of a new day (before any candle closes)
if isNewDay
    ceBase       := na
    peBase       := na
    ceSecondBase := na
    peSecondBase := na
    dayCandleNo  := 0
    resetNow     := true

// On every confirmed (closed) candle, increment counter then capture bases
if barstate.isconfirmed
    dayCandleNo += 1

    if dayCandleNo == 1
        ceBase := ceRawObv
        peBase := peRawObv

    if dayCandleNo == 2
        ceSecondBase := ceRawObv
        peSecondBase := peRawObv

plotshape(showResetDebug and resetNow, title="Daily Baseline Reset", style=shape.labeldown, location=location.top, color=color.yellow, textcolor=color.black, text="RESET", size=size.tiny)

// ===== Delta from Baselines =====
ceDayDelta    = ceRawObv - nz(ceBase, ceRawObv)
peDayDelta    = peRawObv - nz(peBase, peRawObv)

ceFrom1stRaw  = ceDayDelta
peFrom1stRaw  = peDayDelta
ceDayRaw      = ceFrom1stRaw
peDayRaw      = peFrom1stRaw

ceFrom2ndRaw  = not na(ceSecondBase) ? (ceRawObv - ceSecondBase) : na
peFrom2ndRaw  = not na(peSecondBase) ? (peRawObv - peSecondBase) : na

ceFrom1stPct  = math.abs(nz(ceBase)) > 0 ? (ceFrom1stRaw / math.abs(ceBase)) * 100 : 0.0
peFrom1stPct  = math.abs(nz(peBase)) > 0 ? (peFrom1stRaw / math.abs(peBase)) * 100 : 0.0
ceFrom2ndPct  = not na(ceSecondBase) and math.abs(ceSecondBase) > 0 ? (ceFrom2ndRaw / math.abs(ceSecondBase)) * 100 : na
peFrom2ndPct  = not na(peSecondBase) and math.abs(peSecondBase) > 0 ? (peFrom2ndRaw / math.abs(peSecondBase)) * 100 : na

ceRawEma = ta.ema(ceFrom1stRaw, smoothLen)
peRawEma = ta.ema(peFrom1stRaw, smoothLen)
cePctEma = ta.ema(ceFrom1stPct, smoothLen)
pePctEma = ta.ema(peFrom1stPct, smoothLen)

useRaw = displayMode == "Raw"
ceActive = useRaw ? ceRawEma : cePctEma
peActive = useRaw ? peRawEma : pePctEma
crossUp = ta.crossover(ceActive, peActive)
crossDown = ta.crossunder(ceActive, peActive)
ceCrossText = crossUp ? "Bull Cross" : crossDown ? "Bear Cross" : "-"
peCrossText = crossDown ? "Bull Cross" : crossUp ? "Bear Cross" : "-"
ceCrossColor = ceCrossText == "Bull Cross" ? color.lime : ceCrossText == "Bear Cross" ? color.red : color.gray
peCrossColor = peCrossText == "Bull Cross" ? color.lime : peCrossText == "Bear Cross" ? color.red : color.gray

f_json(txt) =>
    _t = str.replace_all(txt, "\n", "\\n")
    str.replace_all(_t, '"', '\\"')

f_webhook_payload(_html_text) =>
    '{"chat_id":"-1003533948678","parse_mode":"HTML","text":"' + f_json(_html_text) + '"}'

if barstate.isconfirmed and crossUp
    modeTxt = useRaw ? "Raw" : "Percent"
    msg_html = "<b>OBV CE/PE CROSS ALERT</b>\n" +
      "<b>" + indexName + "</b> | TF:" + timeframe.period + "\n" +
      "<b>Mode:</b> " + modeTxt + "\n" +
      "<b>Event:</b> Green crossed Red (BULL)\n" +
      "<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

if barstate.isconfirmed and crossDown
    modeTxt = useRaw ? "Raw" : "Percent"
    msg_html = "<b>OBV CE/PE CROSS ALERT</b>\n" +
      "<b>" + indexName + "</b> | TF:" + timeframe.period + "\n" +
      "<b>Mode:</b> " + modeTxt + "\n" +
      "<b>Event:</b> Red crossed Green (BEAR)\n" +
      "<b>CE:</b> " + str.tostring(ceActive, "#.00") + " | <b>PE:</b> " + str.tostring(peActive, "#.00")
    alert(f_webhook_payload(msg_html), alert.freq_once_per_bar_close)

// ===== Plot =====
plot(0, "Opening Candle Baseline", color=color.new(color.gray, 20), linewidth=1, style=plot.style_line)
plot(useRaw ? ceRawEma : na, "CE OBV Raw", color=color.new(color.lime, 0), linewidth=2)
plot(useRaw ? peRawEma : na, "PE OBV Raw", color=color.new(color.red, 0), linewidth=2)
plot(not useRaw ? cePctEma : na, "CE OBV %", color=color.new(color.lime, 0), linewidth=2)
plot(not useRaw ? pePctEma : na, "PE OBV %", color=color.new(color.red, 0), linewidth=2)

// ===== Table =====
f_pct_color(v) =>
    na(v) ? color.new(color.gray, 0) : v > 0 ? color.new(color.lime, 0) : v < 0 ? color.new(color.red, 0) : color.new(color.gray, 0)

f_fmt_km(v) =>
    av = math.abs(v)
    av >= 1000000 ? str.tostring(v / 1000000, "#.00") + "M" : av >= 1000 ? str.tostring(v / 1000, "#.00") + "K" : str.tostring(v, "#.0")

var table t = table.new(position.top_right, 3, 10, border_width=1)

if barstate.islast and showTable
    table.cell(t, 0, 0, "Metric", bgcolor=color.new(color.silver, 15), text_color=color.black)
    table.cell(t, 1, 0, "CE", bgcolor=color.new(color.silver, 15), text_color=color.black)
    table.cell(t, 2, 0, "PE", bgcolor=color.new(color.silver, 15), text_color=color.black)

    table.cell(t, 0, 1, "1st Candle Raw", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 1, f_fmt_km(ceBase), bgcolor=color.new(color.gray, 90), text_color=color.white)
    table.cell(t, 2, 1, f_fmt_km(peBase), bgcolor=color.new(color.gray, 90), text_color=color.white)

    table.cell(t, 0, 2, "2nd Candle Raw", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 2, na(ceSecondBase) ? "Waiting" : f_fmt_km(ceSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(ceSecondBase) ? color.orange : color.white)
    table.cell(t, 2, 2, na(peSecondBase) ? "Waiting" : f_fmt_km(peSecondBase), bgcolor=color.new(color.gray, 90), text_color=na(peSecondBase) ? color.orange : color.white)

    table.cell(t, 0, 3, "Current Raw", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 3, f_fmt_km(ceRawObv), bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceDayRaw))
    table.cell(t, 2, 3, f_fmt_km(peRawObv), bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peDayRaw))

    table.cell(t, 0, 4, "% changed from 1st candle", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 4, str.tostring(ceFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom1stPct))
    table.cell(t, 2, 4, str.tostring(peFrom1stPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom1stPct))

    table.cell(t, 0, 5, "% changed from 2nd candle", bgcolor=color.new(color.gray, 85), text_color=color.white)
    table.cell(t, 1, 5, na(ceFrom2ndPct) ? "-" : str.tostring(ceFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(ceFrom2ndPct))
    table.cell(t, 2, 5, na(peFrom2ndPct) ? "-" : str.tostring(peFrom2ndPct, "#.00") + "%", bgcolor=color.new(color.gray, 90), text_color=f_pct_color(peFrom2ndPct))
